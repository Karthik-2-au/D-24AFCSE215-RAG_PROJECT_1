# Local Ollama endpoint. Ollama integration is added in a later phase.
STUDY_ASSISTANT_OLLAMA_BASE_URL=http://localhost:11434
STUDY_ASSISTANT_LLM_MODEL=qwen2.5:3b
STUDY_ASSISTANT_EMBEDDING_MODEL=nomic-embed-text
STUDY_ASSISTANT_DATA_DIR=data

# Retrieval defaults used by later RAG phases.
STUDY_ASSISTANT_CHUNK_SIZE=800
STUDY_ASSISTANT_CHUNK_OVERLAP=120
STUDY_ASSISTANT_TOP_K=5
STUDY_ASSISTANT_TEMPERATURE=0.2
STUDY_ASSISTANT_MAX_UPLOAD_MB=25
STUDY_ASSISTANT_MAX_RETRIEVAL_DISTANCE=0.75
